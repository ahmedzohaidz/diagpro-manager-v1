# DiagPro Manager V1 — environment variables
# Copy this file to .env.local and fill in your real values.
# Never commit real keys.

# Data mode: "local" (browser localStorage, default) or "supabase".
NEXT_PUBLIC_DATA_MODE=local

# Required only when NEXT_PUBLIC_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
